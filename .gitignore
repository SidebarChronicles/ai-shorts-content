# Secrets — never commit these
client_secret.json
token.json
.env

# Python
.venv*/
__pycache__/
*.pyc

# Large binary / regeneratable media
output/scripts/*/trailer_raw.mp4
output/scripts/*/trailer_raw.mp4.part
output/scripts/*/clips/
output/scripts/*/clips_portrait/
output/scripts/*/clips_source/
output/scripts/*/clips/
.claude/worktrees/
output/scripts/*/bg_clips_concat.txt
output/scripts/*/captions.ass
output/scripts/*/karaoke.filter
output/scripts/*/top_title.filter
output/scripts/*/audio_mixed.mp3
output/videos/*.mp4
output/videos/*.mp4.part
output/game_videos/*.mp4
output/game_videos/*.mp4.part
output/movie_videos/*.mp4
output/movie_videos/*.mp4.part
output/mythology_videos/*.mp4
output/mythology_videos/*.mp4.part
output/mystery_videos/*.mp4
output/mystery_videos/*.mp4.part
output/topx_videos/*.mp4
output/topx_videos/*.mp4.part
output/finance_videos/*.mp4
output/finance_videos/*.mp4.part
output/story_videos/*.mp4
output/story_videos/*.mp4.part

# AI generation caches (regeneratable — re-prompting hits the cache, doesn't re-bill)
output/ai_cache/
output/scripts/*/visuals_raw/
assets/audio/*.aiff
assets/audio/*.mp3
assets/audio/*.mp3.part
assets/audio/*.alignment.json
assets/music/**/*.mp3
assets/music/**/*.wav
assets/sfx/*.wav
assets/sfx/*.mp3
assets/sfx/**/*.wav
assets/sfx/**/*.mp3

# Pytest
.pytest_cache/

# Runtime logs (tracked elsewhere or regeneratable)
output/game_pipeline.log
output/elevenlabs_usage.json

# Claude Code session state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Render artifacts (regeneratable)
output/scripts/*/frames/
output/scripts/*/scenes/
output/scripts/*/timeline_baked.txt
output/scripts/*/preview_frames/
output/qa_frames/

# YOLOv8 weights (auto-downloaded by scripts/smart_crop_yolo.py)
yolov8*.pt
*.engine
*.onnx
assets/models/

# Per-platform caption sidecars (regeneratable via scripts/build_captions.py)
output/*_videos/*.ig_caption.txt
output/*_videos/*.tt_caption.txt
output/videos/*.ig_caption.txt
output/videos/*.tt_caption.txt

# macOS noise
.DS_Store
