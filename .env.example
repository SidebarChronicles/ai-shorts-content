# YouTube upload OAuth — see README_UPLOAD_SETUP.md
# client_secret.json is your Google Cloud OAuth credential file (already in project root)

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2
ELEVENLABS_MONTHLY_BUDGET=22.0
ELEVENLABS_ALIGNMENT=true

# Claude API (for suggest_improvements.py analytics loop)
ANTHROPIC_API_KEY=

# Freesound API — for ambient beds + SFX in story sound design.
# Get a free token at https://freesound.org/apiv2/apply
# Without this, build_sound_design.py falls back to Pixabay (no auth) then silence.
FREESOUND_API_TOKEN=

# ElevenLabs Music API — gated paid feature for hero-beat music cues.
# 0 = off (use local assets/music/ library); 1 = on (paid per generation).
# Leave at 0 unless you've validated the budget and seeded the local library.
ENABLE_ELEVEN_MUSIC=0
